{
  "name": "spaceflight",
  "version": "0.2.0",
  "description": "Space dogfight roguelike game",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run bundle-meshes && tsc && vite build",
    "preview": "vite preview",
    "check-size": "bash scripts/build/check-file-size.sh",
    "bundle-meshes": "node scripts/build/bundle-meshes.mjs",
    "format": "biome format --write src/ scripts/",
    "lint": "biome check src/ scripts/",
    "lint:fix": "biome check --write src/ scripts/",
    "validate-hardpoints": "node scripts/build/validate-hardpoints.mjs",
    "test": "npx tsx scripts/tests/run-tests.mjs",
    "test:all": "npx tsx scripts/tests/run-tests.mjs --all",
    "test:balance": "npx tsx scripts/tests/run-tests.mjs --balance"
  },
  "dependencies": {
    "canvas": "^3.2.0",
    "rng": "^0.2.2",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.11",
    "@gltf-transform/core": "^4.3.0",
    "@types/three": "^0.170.0",
    "fake-indexeddb": "^6.2.5",
    "puppeteer": "^24.34.0",
    "svgo": "^4.0.0",
    "ts-morph": "^27.0.2",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "packageManager": "npm@11.4.1+sha512.fcee43884166b6f9c5d04535fb95650e9708b6948a1f797eddf40e9778646778a518dfa32651b1c62ff36f4ac42becf177ca46ca27d53f24b539190c8d91802b"
}
