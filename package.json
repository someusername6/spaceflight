{
  "name": "spaceflight",
  "version": "0.4.0",
  "description": "Space dogfight roguelike game",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run bundle-meshes && tsc && vite build",
    "preview": "vite preview",
    "check-size": "bash scripts/build/check-file-size.sh",
    "bundle-meshes": "node scripts/build/bundle-meshes.mjs",
    "format": "biome format --write src/ scripts/",
    "lint": "biome check src/ scripts/",
    "lint:fix": "biome check --write src/ scripts/",
    "validate-hardpoints": "node scripts/build/validate-hardpoints.mjs",
    "test": "npx tsx scripts/tests/run-tests.mjs",
    "test:all": "npx tsx scripts/tests/run-tests.mjs --all",
    "test:balance": "npx tsx scripts/tests/run-tests.mjs --balance",
    "test:signaling": "JOIN_RATE_LIMIT_PER_SECOND=1000 CREATE_RATE_LIMIT_PER_MINUTE=1000 node --test scripts/tests/signaling/test-room-lifecycle.mjs scripts/tests/signaling/test-signaling-relay.mjs scripts/tests/signaling/test-mesh-formation.mjs scripts/tests/signaling/test-rate-limiting.mjs",
    "test:signaling:cleanup": "node --test scripts/tests/signaling/test-cleanup.mjs",
    "signaling:install": "cd server/signaling && npm install",
    "signaling:dev": "cd server/signaling && npm run dev"
  },
  "dependencies": {
    "canvas": "^3.2.0",
    "rng": "^0.2.2",
    "rollback-netcode": "^0.0.5",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.11",
    "@gltf-transform/core": "^4.3.0",
    "@types/three": "^0.170.0",
    "fake-indexeddb": "^6.2.5",
    "incremental-convex-hull": "^1.0.1",
    "playwright": "^1.58.0",
    "puppeteer": "^24.34.0",
    "svgo": "^4.0.0",
    "ts-morph": "^27.0.2",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "packageManager": "npm@11.4.1+sha512.fcee43884166b6f9c5d04535fb95650e9708b6948a1f797eddf40e9778646778a518dfa32651b1c62ff36f4ac42becf177ca46ca27d53f24b539190c8d91802b"
}
