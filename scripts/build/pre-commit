#!/bin/bash
# Pre-commit hook: runs linting, file size check, and tests
# Install with: cp scripts/build/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit

set -e

echo "Running pre-commit checks..."

# Run Biome lint/format check (skip if no lintable files staged)
STAGED_LINTABLE=$(git diff --cached --name-only -- 'src/*.ts' 'src/*.tsx' 'src/*.js' 'src/*.mjs' 'scripts/*.ts' 'scripts/*.mjs' 'scripts/*.js' | head -1)
if [ -n "$STAGED_LINTABLE" ]; then
  echo "Checking formatting and lint..."
  npx biome check --staged src/ scripts/
else
  echo "No lintable files staged, skipping lint check."
fi

# Run TypeScript type check
echo "Checking TypeScript types..."
npx tsc --noEmit

# Run file size check
echo "Checking file sizes..."
bash scripts/build/check-file-size.sh

# Run quick tests
echo "Running tests..."
npm test

echo "Pre-commit checks passed!"
